<?xml version="1.0" encoding="utf-8"?>
<!-- A machine with only Visual Studio installed has the offline package source registered and
     nothing else, and `dotnet run` then fails to restore FFMpegCore with an error that names
     the package rather than the source. This adds nuget.org for this project only, without
     touching the user's own configuration. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
