<Project Sdk="Microsoft.NET.Sdk">

  <!-- The engine's second implementation: make_video.sh in C#, so a Windows host assembles
       the video without WSL. make_videos.ps1 runs it at the exact call site where it used to
       cross into WSL, with the same environment variables, so everything that script resolves
       (voice, rate, language, titleAssets) reaches both engines the same way.

       net10.0 only, on purpose: the read-aloud service answers 403 to a handshake without a
       User-Agent, and .NET Framework's ClientWebSocket refuses to send that header. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>E2EVideoDoc.Engine</RootNamespace>
    <AssemblyName>e2e-video-doc-engine</AssemblyName>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Builds the ffmpeg arguments. The binary is not in the package: the next one fetches it. -->
    <PackageReference Include="FFMpegCore" Version="5.4.0" />
    <!-- Fetches ffmpeg and ffprobe the first time they are needed (see Assemble.EnsureFFmpeg). -->
    <PackageReference Include="FFMpegCore.Extensions.Downloader" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

</Project>
